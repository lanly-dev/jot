# =============================================================================
# Jot — Environment variable reference
# -----------------------------------------------------------------------------
# Copy this file to `.env` and adjust values as needed, then run:
#   docker compose up -d
# =============================================================================

# Port the Express server listens on inside the container.
# The host port (left side of docker-compose ports) maps to this.
PORT=3000

# AES-256-GCM encryption key for credential "password" and "notes" fields.
# Provide a base64-encoded 32-byte key to make your encrypted data portable
# across machines/containers. If left blank, a random key is generated
# inside the container on first start (NOT recoverable if the container is
# deleted without a volume backup).
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JOT_SECRET_KEY=

# Application environment (used by server.js to toggle dev-only live-reload).
# Do NOT change from "production" for Docker deployments.
NODE_ENV=production

# API authentication token. When set, every /api route requires
# `Authorization: Bearer <token>`; the web UI prompts for it once and keeps it
# in the browser's localStorage. Leave blank only for local development — the
# server logs a loud warning when it starts unauthenticated.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JOT_API_TOKEN=

# Set to 0 to disable the in-app self-updater (/api/update/*). The updater
# runs git + npm install as the service user; disable it if you prefer
# updates to happen only from the host shell via update-jot.sh.
JOT_ALLOW_SELF_UPDATE=1
